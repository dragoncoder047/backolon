{
    "$schema": "https://typedoc.org/schema.json",
    "entryPointStrategy": "expand",
    "tsconfig": "./tsconfig.json",
    "exclude": [
        "./test/**/*",
        "./node_modules/**/*"
    ],
    "excludePrivate": true,
    "excludeExternals": true,
    "hideGenerator": true,
    "includeVersion": true,
    "disableSources": false,
    "skipErrorChecking": true,
    "disableGit": true,
    "sourceLinkTemplate": "about:invalid",
    "favicon": "./website/images/icon.png",
    "useTsLinkResolution": true,
    "preservedTypeAnnotationTags": [
        "@param",
        "@returns",
        "@type",
    ],
    "ignoredHighlightLanguages": [
        "backolon"
    ],
    "intentionallyNotExported": [
    ],
    "externalSymbolLinkMappings": {
        "bun": {
            "BunPlugin": "https://bun.com/docs/bundler/plugins"
        },
        "ts-res": {
            "Result": "https://www.npmjs.com/package/ts-res",
            "Err": "https://www.npmjs.com/package/ts-res",
            "Ok": "https://www.npmjs.com/package/ts-res",
        },
        "@r47onfire/jeb": {
            "Continuation": "/api/jeb/classes/Continuation.html",
            "JebVM": "/api/jeb/classes/JebVM.html",
            "Env": "/api/jeb/classes/Env.html",
            "EnvVarLValue": "/api/jeb/classes/EnvVarLValue.html"
        },
    }
}
