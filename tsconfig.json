{
    "compilerOptions": {
        "noEmit": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitAny": true,
        "noFallthroughCasesInSwitch": true,
        "strictNullChecks": true,
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "types": [
            "bun",
            "jquery",
            "node",
            "prismjs",
            "markdown-it"
        ],
        "lib": [
            "esnext",
            "dom"
        ],
    },
    "include": [
        "./**/*.ts",
        "./jeb/src/**/*.ts"
    ],
    "exclude": [
        "v1/**"
    ]
}