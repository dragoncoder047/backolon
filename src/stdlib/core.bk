callcc = [f] => (
    "Call-with-current-continuation"
    f return
)
while = [^cond, ^body] => (
    "while loop"
    callcc [break] => (
        continue = nil
        callcc [k] => continue := k
        if cond(), (
            body [`break:, `continue:]
            continue()
        )
    )
)
generator = [^body] => (
    cont = nil
    resume = [] => (body [`yield:]; done)
    yield = [value] => callcc [k] => (
        resume := k
        cont value
    )
    [] => callcc [k] => (
        cont := k
        resume()
    )
)
foreach = [@varname, list, ^body] => (
    i = 0
    while i < #list, (
        callcc [k] => body [varname: list->i, `break:, `continue: k]
        i++
    )
)
# don't "return" anything
;;
